        "receipt_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Receipt Id"
        },
        "state_version": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "State Version"
        },
        "evidence": {
          "title": "Evidence",
          "type": "object"
        }
      },
      "required": [
        "call_id",
        "status"
      ],
      "title": "ToolResult",
      "type": "object"
    },
    "DisplayCommand": {
      "additionalProperties": false,
      "properties": {
        "delivery_id": {
          "title": "Delivery Id",
          "type": "string"
        },
        "task_id": {
          "title": "Task Id",
          "type": "string"
        },
        "task_version": {
          "title": "Task Version",
          "type": "integer"
        },
        "occurrence": {
          "title": "Occurrence",
          "type": "integer"
        },
        "content": {
          "title": "Content",
          "type": "string"
        },
        "requested_at": {
          "format": "date-time",
          "title": "Requested At",
          "type": "string"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "reason": {
          "enum": [
            "hard_due",
            "opportunity",
            "deadline_fallback",
            "tool",
            "retry"
          ],
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "delivery_id",
        "task_id",
        "task_version",
        "occurrence",
        "content",
        "requested_at",
        "expires_at",
        "reason"
      ],
      "title": "DisplayCommand",
      "type": "object"
    },
    "DisplayReceipt": {
      "additionalProperties": false,
      "properties": {
        "delivery_id": {
          "title": "Delivery Id",
          "type": "string"
        },
        "task_id": {
          "title": "Task Id",
          "type": "string"
        },
        "task_version": {
          "title": "Task Version",
          "type": "integer"
        },
        "rendered_at": {
          "format": "date-time",
          "title": "Rendered At",
          "type": "string"
        },
        "outcome": {
          "enum": [
            "displayed",
            "failed",
            "rejected"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "source": {
          "enum": [
            "simulated",
            "native",
            "offscreen"
          ],
          "title": "Source",
          "type": "string"
        },
        "error_code": {
          "anyOf": [
            {
              "$ref": "#/$defs/ErrorCode"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "delivery_id",
        "task_id",
        "task_version",
        "rendered_at",
        "outcome",
        "source"
      ],
      "title": "DisplayReceipt",
      "type": "object"
    },
    "UiComponent": {
      "additionalProperties": false,
      "properties": {
        "component_id": {
          "title": "Component Id",
          "type": "string"
        },
        "type": {
          "enum": [
            "text",
            "card",
            "text_input",
            "select",
            "button",
            "list"
          ],
          "title": "Type",
          "type": "string"
        },
        "label": {
          "default": "",
          "title": "Label",
          "type": "string"
        },
        "action_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Action Id"
        },
        "options": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Options",
          "type": "array"
        },
        "data_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Data Key"
        }
      },
      "required": [
        "component_id",
        "type"
      ],
      "title": "UiComponent",
      "type": "object"
    },
    "UiSpec": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "enum": [
            1
          ],
          "title": "Schema Version",
          "type": "integer"
        },
        "surface_id": {
          "title": "Surface Id",
          "type": "string"
        },
        "surface_revision": {
          "minimum": 1,
          "title": "Surface Revision",
          "type": "integer"
        },
        "task_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Task Id"
        },
        "task_version": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Task Version"
        },
        "components": {
          "default": [],
          "items": {
            "$ref": "#/$defs/UiComponent"
          },
          "title": "Components",
          "type": "array"
        },
        "data": {
          "title": "Data",
          "type": "object"
        }
      },
      "required": [
        "surface_id",
        "surface_revision"
      ],
      "title": "UiSpec",
      "type": "object"
