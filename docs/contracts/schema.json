{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mochi M0 public contracts",
  "x-contract-version": 1,
  "$defs": {
    "RawSignals": {
      "additionalProperties": false,
      "description": "Timestamped measurements, never a conclusion about the user's state.",
      "properties": {
        "sample_id": {
          "title": "Sample Id",
          "type": "string"
        },
        "sampler_id": {
          "default": "unspecified",
          "title": "Sampler Id",
          "type": "string"
        },
        "sampled_at": {
          "format": "date-time",
          "title": "Sampled At",
          "type": "string"
        },
        "valid_until": {
          "format": "date-time",
          "title": "Valid Until",
          "type": "string"
        },
        "source": {
          "default": "scripted",
          "enum": [
            "scripted",
            "live"
          ],
          "title": "Source",
          "type": "string"
        },
        "capabilities": {
          "additionalProperties": {
            "type": "boolean"
          },
          "title": "Capabilities",
          "type": "object"
        },
        "application": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Application"
        },
        "idle_s": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Idle S"
        },
        "input_active": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Active"
        },
        "cursor_position": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cursor Position"
        },
        "window_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Window Count"
        },
        "errors": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Errors",
          "type": "array"
        }
      },
      "required": [
        "sample_id",
        "sampled_at",
        "valid_until"
      ],
      "title": "RawSignals",
      "type": "object"
    },
    "StateEvidence": {
      "additionalProperties": false,
      "properties": {
        "ref": {
          "title": "Ref",
          "type": "string"
        },
        "signal": {
          "title": "Signal",
          "type": "string"
        },
        "value": {
          "default": null,
          "title": "Value"
        },
        "sampled_at": {
          "format": "date-time",
          "title": "Sampled At",
          "type": "string"
        },
        "valid_until": {
          "format": "date-time",
          "title": "Valid Until",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "ref",
        "signal",
        "sampled_at",
        "valid_until",
        "source"
      ],
      "title": "StateEvidence",
      "type": "object"
    },
    "UserCorrection": {
      "additionalProperties": false,
      "properties": {
        "origin": {
          "default": "user",
          "enum": [
            "user",
            "scripted",
            "automation"
          ],
          "title": "Origin",
          "type": "string"
        },
        "correction_id": {
          "title": "Correction Id",
          "type": "string"
        },
        "state": {
          "enum": [
            "working",
            "available",
            "away",
            "unknown"
          ],
          "title": "State",
          "type": "string"
        },
        "reason": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "valid_until": {
          "format": "date-time",
          "title": "Valid Until",
          "type": "string"
        }
      },
      "required": [
        "correction_id",
        "state",
        "reason",
        "created_at",
        "valid_until"
      ],
      "title": "UserCorrection",
      "type": "object"
    },
    "UserStateEstimate": {
      "additionalProperties": false,
      "properties": {
        "estimator_id": {
          "default": "unspecified",
          "title": "Estimator Id",
          "type": "string"
        },
        "based_on_sample_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Based On Sample Id"
        },
        "evidence_details": {
          "default": [],
          "items": {
            "$ref": "#/$defs/StateEvidence"
          },
          "title": "Evidence Details",
          "type": "array"
        },
        "state": {
          "default": "unknown",
          "enum": [
            "working",
            "available",
            "away",
            "unknown"
          ],
          "title": "State",
          "type": "string"
        },
        "evidence": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Evidence",
          "type": "array"
        },
        "source": {
          "default": "scripted",
          "enum": [
            "rule",
            "scripted",
            "user",
            "model"
          ],
          "title": "Source",
          "type": "string"
        },
        "valid_until": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid Until"
        }
      },
      "title": "UserStateEstimate",
      "type": "object"
    },
    "Observation": {
      "additionalProperties": false,
      "properties": {
        "raw": {
          "anyOf": [
            {
              "$ref": "#/$defs/RawSignals"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "correction": {
          "anyOf": [
            {
              "$ref": "#/$defs/UserCorrection"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "context_revision": {
          "default": 1,
          "minimum": 1,
          "title": "Context Revision",
          "type": "integer"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "estimate": {
          "$ref": "#/$defs/UserStateEstimate"
        },
        "capabilities": {
          "additionalProperties": {
            "type": "boolean"
          },
          "title": "Capabilities",
          "type": "object"
        },
        "application": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Application"
        },
        "idle_s": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Idle S"
        },
        "source": {
          "default": "scripted",
          "enum": [
            "scripted",
            "live"
          ],
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "observed_at"
      ],
      "title": "Observation",
      "type": "object"
    },
    "ObservationFrame": {
      "additionalProperties": false,
      "description": "Inspectable pipeline state, including the estimate before user correction.",
      "properties": {
        "observation": {
          "$ref": "#/$defs/Observation"
        },
        "raw": {
          "anyOf": [
            {
              "$ref": "#/$defs/RawSignals"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "raw_status": {
          "enum": [
            "fresh",
            "expired",
            "missing",
            "future",
            "error"
          ],
          "title": "Raw Status",
          "type": "string"
        },
        "estimated": {
          "$ref": "#/$defs/UserStateEstimate"
        },
        "correction": {
          "anyOf": [
            {
              "$ref": "#/$defs/UserCorrection"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "correction_status": {
          "default": "none",
          "enum": [
            "none",
            "active",
            "expired",
            "cleared"
          ],
          "title": "Correction Status",
          "type": "string"
        },
        "sampling_name": {
          "title": "Sampling Name",
          "type": "string"
        },
        "estimator_name": {
          "title": "Estimator Name",
          "type": "string"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        }
      },
      "required": [
        "observation",
        "raw_status",
        "estimated",
        "sampling_name",
        "estimator_name"
      ],
      "title": "ObservationFrame",
      "type": "object"
    },
    "TaskDraft": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Content",
          "type": "string"
        },
        "mode": {
          "default": "soft",
          "enum": [
            "hard",
            "soft"
          ],
          "title": "Mode",
          "type": "string"
        },
        "timezone": {
          "default": "UTC",
          "title": "Timezone",
          "type": "string"
        },
        "earliest_at": {
          "format": "date-time",
          "title": "Earliest At",
          "type": "string"
        },
        "latest_first_delivery_at": {
          "format": "date-time",
          "title": "Latest First Delivery At",
          "type": "string"
        }
      },
      "required": [
        "content",
        "earliest_at",
        "latest_first_delivery_at"
      ],
      "title": "TaskDraft",
      "type": "object"
    },
    "TaskView": {
      "additionalProperties": false,
      "properties": {
        "task_id": {
          "title": "Task Id",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "draft": {
          "$ref": "#/$defs/TaskDraft"
        },
        "status": {
          "default": "draft",
          "enum": [
            "draft",
            "registered",
            "completed",
            "cancelled"
          ],
          "title": "Status",
          "type": "string"
        },
        "occurrence": {
          "default": 1,
          "minimum": 1,
          "title": "Occurrence",
          "type": "integer"
        },
        "confirmed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confirmed At"
        },
        "displayed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Displayed At"
        }
      },
      "required": [
        "task_id",
        "version",
        "draft"
      ],
      "title": "TaskView",
      "type": "object"
    },
    "TaskCommand": {
      "additionalProperties": false,
      "properties": {
        "command_id": {
          "title": "Command Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "create",
            "confirm",
            "edit",
            "snooze",
            "cancel",
            "complete"
          ],
          "title": "Kind",
          "type": "string"
        },
        "task_id": {
          "title": "Task Id",
          "type": "string"
        },
        "expected_version": {
          "default": 0,
          "minimum": 0,
          "title": "Expected Version",
          "type": "integer"
        },
        "payload": {
          "title": "Payload",
          "type": "object"
        }
      },
      "required": [
        "command_id",
        "kind",
        "task_id"
      ],
      "title": "TaskCommand",
      "type": "object"
    },
    "ErrorCode": {
      "enum": [
        "STALE_TASK",
        "STALE_CONTEXT",
        "STALE_SURFACE",
        "EXPIRED_REQUEST",
        "CANCELLED",
        "OUTSIDE_WINDOW",
        "DUPLICATE",
        "INVALID_TRANSITION",
        "INVALID_ARGUMENT",
        "NOT_FOUND",
        "UNKNOWN_TOOL",
        "TIMEOUT",
        "FAILED",
        "BUDGET_EXCEEDED",
        "UNSUPPORTED"
      ],
      "title": "ErrorCode",
      "type": "string"
    },
    "CommandResult": {
      "additionalProperties": false,
      "properties": {
        "command_id": {
          "title": "Command Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "applied",
            "rejected",
            "duplicate"
          ],
          "title": "Status",
          "type": "string"
        },
        "actual_version": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Actual Version"
        },
        "error_code": {
          "anyOf": [
            {
              "$ref": "#/$defs/ErrorCode"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "view": {
          "anyOf": [
            {
              "$ref": "#/$defs/TaskView"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "message": {
          "default": "",
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "command_id",
        "status"
      ],
      "title": "CommandResult",
      "type": "object"
    },
    "DecisionEnvelope": {
      "additionalProperties": false,
      "properties": {
        "request_id": {
          "title": "Request Id",
          "type": "string"
        },
        "task_id": {
          "title": "Task Id",
          "type": "string"
        },
        "task_version": {
          "minimum": 1,
          "title": "Task Version",
          "type": "integer"
        },
        "context_revision": {
          "minimum": 1,
          "title": "Context Revision",
          "type": "integer"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        }
      },
      "required": [
        "request_id",
        "task_id",
        "task_version",
        "context_revision",
        "created_at",
        "expires_at"
      ],
      "title": "DecisionEnvelope",
      "type": "object"
    },
    "ToolCall": {
      "additionalProperties": false,
      "properties": {
        "call_id": {
          "title": "Call Id",
          "type": "string"
        },
        "tool_name": {
          "title": "Tool Name",
          "type": "string"
        },
        "args": {
          "title": "Args",
          "type": "object"
        },
        "envelope": {
          "$ref": "#/$defs/DecisionEnvelope"
        },
        "idempotency_key": {
          "title": "Idempotency Key",
          "type": "string"
        }
      },
      "required": [
        "call_id",
        "tool_name",
        "envelope",
        "idempotency_key"
      ],
      "title": "ToolCall",
      "type": "object"
    },
    "ProposedPlan": {
      "additionalProperties": false,
      "properties": {
        "envelope": {
          "$ref": "#/$defs/DecisionEnvelope"
        },
        "calls": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ToolCall"
          },
          "title": "Calls",
          "type": "array"
        }
      },
      "required": [
        "envelope"
      ],
      "title": "ProposedPlan",
      "type": "object"
    },
    "ToolResult": {
      "additionalProperties": false,
      "properties": {
        "call_id": {
          "title": "Call Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "succeeded",
            "pending",
            "rejected",
            "failed",
            "timeout",
            "duplicate"
          ],
          "title": "Status",
          "type": "string"
        },
        "error_code": {
          "anyOf": [
            {
              "$ref": "#/$defs/ErrorCode"
            },
            {
              "type": "null"
            }
          ],
          "default": null
